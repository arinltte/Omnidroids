# ============================================================================
# Omnidroids — example environment.
# Copy to `.env` and edit. Everything is local; no cloud services are used.
#   cp .env.example .env
# Platform notes live inline; see README for macOS vs Windows specifics.
# ============================================================================

# ---- LLM address (this repo's own OpenAI-compatible runtime endpoint) --------
# All app services and OASIS sub-agents send OpenAI-format requests here; the
# backend's /v1 endpoint routes them to a loaded local model (Phase 1 runtime).
LLM_API_KEY=omnidroids-local
LLM_BASE_URL=http://localhost:5001/v1
# Steps 1-3 (Graph Build, Env Setup, Run Simulation) resolve this name; the
# /v1 proxy maps it to the 'small' role in models/registry.json. Ollama is
# removed (B5/#14) — no "model:tag" here: this is the MLX 'small' role's model,
# assigned in the Model Manager, and an unrecognised name still lands there.
LLM_MODEL_NAME=LFM3-1.7B-MLX-4bit

# ---- Steps 4-5 (Report Generation, Deep Interaction) ------------------------
# Both steps are served by the ReportAgent and run the 'big' role instead of
# LLM_MODEL_NAME (owner decision, issue #22; docs/MODEL_EVAL.md §1b). The model
# NAME is never written here: it is re-read from the Model Manager registry on
# every call, so reassigning the 'big' role there needs no code change.
REPORT_LLM_ROLE=big
# Optional explicit model name for those steps (must be installed in the Model
# Manager). Empty = use the role assignment above. This is the knob to point
# steps 4-5 at a different 9B-class model.
# REPORT_LLM_MODEL_NAME=

# ---- Reasoning/thinking ------------------------------------------------------
# none = off (fast, stable, valid JSON). Validated: with a 1.7B model, thinking
# ON is 4-6x slower and breaks per-agent action decisions. Default: none.
LLM_REASONING_EFFORT=none

# ---- Concurrency + context ---------------------------------------------------
# Parallel requests inside one loaded model instance; context window.
LLM_NUM_PARALLEL=4
LLM_CONTEXT_LENGTH=8192

# ---- Per-call forward timeout (seconds) --------------------------------------
# Large enough for long-prefill cold starts; must stay below the frontend's
# 1800s axios ceiling.
LLM_PROXY_TIMEOUT=1800

# ---- Graph backend -----------------------------------------------------------
# graphiti = local Graphiti + embedded Kuzu (no key, no cloud). zep = Zep Cloud
# (needs ZEP_API_KEY; unsupported by default in local-only mode).
GRAPH_BACKEND=graphiti

# ZEP_API_KEY is NOT needed for the local Graphiti backend. Left blank/commented.
# ZEP_API_KEY=

# ---- Local Graphiti extractor (validated defaults) ---------------------------
GRAPHITI_LLM_MAX_TOKENS=4096
# GRAPHITI_STRUCTURED_OUTPUT_MODE=json_schema
#   json_schema (default) sends the schema only in response_format, which the
#   /v1 proxy strips for local backends — so the model never sees graphiti's key
#   names. graphiti_zep._CappedLLMClient appends graphiti's own schema reminder
#   to the prompt instead (issue #22), which makes this setting irrelevant to
#   what the model sees; set json_object only to also ask the proxy for it.
# GRAPHITI_EMBEDDING_MODEL=Snowflake/snowflake-arctic-embed-s
# GRAPHITI_EMBEDDING_DIM=384
# GRAPHITI_MAX_COROUTINES=2
# GRAPHITI_MAX_SKIPPED_FRACTION=0.3
# GRAPHITI_DATA_DIR=backend/data/graphiti

# ---- Simulation --------------------------------------------------------------
# Keep 6 unless the owner explicitly changes it.
OASIS_DEFAULT_MAX_ROUNDS=6

# ---- Model runtime (used by the Model Manager + task pipeline from Phase 1) --
# RAM budget (GB) the model manager keeps free on top of the OS on a 16 GB Mac.
MODEL_RAM_BUDGET_GB=11
# Idle seconds before a loaded model is hard-unloaded as a safety net.
MODEL_IDLE_UNLOAD_SECONDS=120
# The role slots the pipeline uses (small / big / embed) are assigned in the
# Model Manager UI and stored in models/registry.json — not here. Which role a
# step runs is set by LLM_MODEL_NAME (steps 1-3) and REPORT_LLM_ROLE (steps
# 4-5) above.

# Do NOT set LLM_BOOST_* (unused locally) or ZEP_API_URL (only Zep Cloud).
