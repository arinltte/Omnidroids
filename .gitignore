.cache/
models/*
!models/README.md

# Secrets
.env
# The scoped pylint gate's cache
backend/.pylint.d/

# OS
.DS_Store

# Internal session notes (never published)
NEXT_SESSION_PROMPT*

# OASIS runtime logging (module-level setup writes ./log on import; test-run byproduct)
log/

# Internal session-management docs — deliberately not published.
HANDOFF.md
AGENTS.md
