# Python
__pycache__/
*.pyc
.venv/
# The pre-commit gate's ruff cache (scripts/pre-commit)
.ruff_cache/
backend/.ruff_cache/

# Frontend
node_modules/
frontend/dist/

# Runtime data & logs
logs/
data/
uploads/
scratch/

# HuggingFace cache + local model weights — NEVER committed.
